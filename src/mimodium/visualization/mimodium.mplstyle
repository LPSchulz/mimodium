# Neutral default plotting style for Mimodium examples and visualizations.
axes.grid: True
axes.prop_cycle: cycler(color=["#2f6f9f", "#bf3b30", "#4f8f5b", "#d08a24", "#665c9f", "#4c9ca0", "#6f6f6f"])
grid.alpha: 0.35
grid.linestyle: --

font.family: sans-serif
font.size: 11

lines.linewidth: 2.0
lines.markersize: 6
lines.markeredgewidth: 1.5

legend.frameon: True
legend.fancybox: False
legend.framealpha: 0.9

pdf.fonttype: 42
ps.fonttype: 42
savefig.bbox: tight
savefig.pad_inches: 0.02

xtick.direction: in
ytick.direction: in
xtick.major.size: 4
ytick.major.size: 4
